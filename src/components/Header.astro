---
import { SITE, PRODUCT_CATEGORIES, POPULAR_TAGS } from '../data/site';
---

<header class="large site-header-cn">
  <!-- 顶部弹出搜索栏 -->
  <div class="top-search clearfix">
    <div class="input-group container">
      <em>您正在寻找什么产品？</em>
      <div class="header_search clearfix">
        <form action="/category.html" method="get">
          <input name="labels" type="text" class="form-control" placeholder="输入产品名称、功率或标签搜索..." />
          <input type="submit" class="search_btn btn_search1" value="" />
        </form>
      </div>
      <span class="input-group-addon close-search" aria-label="关闭搜索">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </span>
      <div class="popular_searches">
        <div class="search_title">热门搜索</div>
        <ul class="clearfix">
          {POPULAR_TAGS.map((tag) => (
            <li><a href={`/category-tags-${tag.id}.html`}>{tag.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- 主导航栏 -->
  <div class="header clearfix">
    <div class="container-big cn-header-inner">
      <!-- 左侧横版 LOGO（适配 380x114） -->
      <div class="cn-brand">
        <a href="/" title={SITE.title}>
          <img
            src={SITE.logoDark}
            alt={SITE.title}
            width="380"
            height="114"
            decoding="async"
            fetchpriority="high"
          />
        </a>
      </div>

      <!-- 右侧双层 B2B 导航区 -->
      <div class="header_right cn-nav-right">
        <!-- 上排：咨询热线 + 辅助导航 -->
        <div class="header_top cn-top-bar">
          <a class="cn-hotline" rel="nofollow" href={`Tel:${SITE.phone}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>咨询热线：{SITE.phone}</span>
          </a>
          <span class="cn-top-divider" aria-hidden="true"></span>
          <ul class="menu cn-top-menu">
            <li><a href="/about-us.html">关于宏晟</a></li>
            <li><a href="/project.html">项目案例</a></li>
            <li><a href="/play-solar.html">光伏知识</a></li>
            <li><a href="/technical-services.html">技术支持</a></li>
            <li><a href="/faq.html">常见问题</a></li>
            <li><a href="/contact-us.html">联系我们</a></li>
          </ul>
        </div>

        <!-- 下排：无箭头极简主导航 + 搜索 + 获取报价按钮 -->
        <div class="header_bottom cn-main-bar">
          <div class="mainmenu-area">
            <div class="mainmenu-left visible-lg visible-md">
              <div class="mainmenu">
                <nav>
                  <ul class="clearfix cn-main-menu">
                    {PRODUCT_CATEGORIES.map((cat) => (
                      <li class="product_vmegamenu">
                        <a href={`/category-${cat.id}.html`}>{cat.name}</a>
                        {cat.children && cat.children.length > 0 && (
                          <ul class="vmegamenu">
                            {cat.children.map((sub) => (
                              <li>
                                <a href={`/category-${sub.id}.html`} class="title">{sub.name}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </div>
          </div>

          <div class="cn-header-actions">
            <div class="search_box">
              <div class="attr-nav">
                <a class="search cn-search-btn" href="javascript:void(0);" title="搜索产品" aria-label="搜索产品">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </a>
              </div>
            </div>
            <a href="/contact-us.html" class="cn-quote-btn">获取报价</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 移动端抽屉导航 -->
    <div class="wrapper">
      <nav id="main-nav">
        <ul class="first-nav">
          <li><a href="/">主页</a></li>
        </ul>
        <ul class="second-nav">
          <li>
            <a href="/category.html">产品</a>
            <ul class="nav_child">
              {PRODUCT_CATEGORIES.map((cat) => (
                <li>
                  <a href={`/category-${cat.id}.html`}>{cat.name}</a>
                  {cat.children && cat.children.length > 0 && (
                    <ul>
                      {cat.children.map((sub) => (
                        <li><a href={`/category-${sub.id}.html`}>{sub.name}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </li>
          <li>
            <a href="/about-us.html">关于宏晟</a>
            <ul class="nav_child">
              <li><a href="/about-us.html">公司简介</a></li>
              <li><a href="/why-we-different.html">为什么我们不同</a></li>
              <li><a href="/news.html">新闻与事件</a></li>
            </ul>
          </li>
          <li><a href="/project.html">项目案例</a></li>
          <li>
            <a href="/play-solar.html">光伏知识</a>
            <ul class="nav_child">
              <li><a href="/news-8.html">为什么选择光伏？</a></li>
              <li><a href="/news-9.html">光伏系统的好处</a></li>
              <li><a href="/faq.html">常见问题</a></li>
            </ul>
          </li>
          <li>
            <a href="/technical-services.html">技术支持</a>
            <ul class="nav_child">
              <li><a href="/technical-services.html">技术服务</a></li>
            </ul>
          </li>
          <li><a href="/contact-us.html">联系我们</a></li>
        </ul>
      </nav>
      <a class="toggle"><span></span><span></span><span></span></a>
    </div>
  </div>
</header>

<style is:global>
  /* =========================================================
     宏晟光伏中文站 - 现代极简导航栏 + 380x114 LOGO
     ========================================================= */
  header.site-header-cn,
  header.site-header-cn.large,
  header.site-header-cn.small {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.98) !important;
    box-shadow: 0 2px 16px rgba(15, 23, 42, 0.06) !important;
    border-bottom: 1px solid #e5e7eb !important;
    transition: all 0.25s ease;
    z-index: 999 !important;
  }

  /* 彻底禁止导航栏内任何链接出现浏览器或 Bootstrap 默认下划线 */
  header.site-header-cn a,
  header.site-header-cn a:hover,
  header.site-header-cn a:focus {
    text-decoration: none !important;
  }

  header.site-header-cn .header {
    padding: 0 !important;
    height: auto !important;
    background: transparent !important;
  }

  header.site-header-cn .cn-header-inner {
    max-width: 1320px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding: 10px 24px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 28px !important;
    box-sizing: border-box;
    transition: padding 0.25s ease;
  }

  header.site-header-cn.small .cn-header-inner {
    padding: 6px 24px !important;
  }

  header.site-header-cn .cn-header-inner::before,
  header.site-header-cn .cn-header-inner::after {
    display: none !important;
    content: none !important;
  }

  /* 左侧 LOGO 区 */
  header.site-header-cn .cn-brand {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  header.site-header-cn .cn-brand a {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  header.site-header-cn .cn-brand img {
    height: 58px !important;
    width: auto !important;
    max-width: 220px !important;
    object-fit: contain;
    display: block !important;
    transition: height 0.25s ease;
  }

  header.site-header-cn.small .cn-brand img {
    height: 48px !important;
  }

  /* 右侧双层导航容器 */
  header.site-header-cn .cn-nav-right {
    float: none !important;
    width: auto !important;
    flex: 1 1 auto;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* 上排：热线 + 辅助导航 */
  header.site-header-cn .cn-top-bar {
    float: none !important;
    width: auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 16px !important;
    padding: 0 0 7px 0 !important;
    margin: 0 0 2px 0 !important;
    border-bottom: 1px solid #f1f5f9 !important;
  }

  header.site-header-cn .cn-hotline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px !important;
    font-weight: 600 !important;
    color: #2596d1 !important;
    white-space: nowrap;
  }

  header.site-header-cn .cn-hotline svg {
    flex-shrink: 0;
  }

  header.site-header-cn .cn-top-divider {
    width: 1px;
    height: 12px;
    background: #cbd5e1;
    display: inline-block;
  }

  header.site-header-cn .cn-top-menu {
    float: none !important;
    width: auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  header.site-header-cn .cn-top-menu li {
    position: relative;
    padding: 0 11px !important;
    margin: 0 !important;
    line-height: 1.2 !important;
  }

  header.site-header-cn .cn-top-menu li:first-child {
    padding-left: 0 !important;
  }

  header.site-header-cn .cn-top-menu li:last-child {
    padding-right: 0 !important;
  }

  header.site-header-cn .cn-top-menu li + li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 11px;
    background: #e2e8f0;
  }

  header.site-header-cn .cn-top-menu li a {
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #64748b !important;
    transition: color 0.2s ease;
    white-space: nowrap !important;
  }

  header.site-header-cn .cn-top-menu li a:hover {
    color: #2596d1 !important;
  }

  /* 下排：主导航 + 搜索 + 获取报价 */
  header.site-header-cn .cn-main-bar {
    float: none !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 24px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  header.site-header-cn .mainmenu-area,
  header.site-header-cn .mainmenu-left,
  header.site-header-cn .mainmenu {
    float: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  header.site-header-cn .cn-main-menu {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 6px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  header.site-header-cn .cn-main-menu > li {
    position: relative;
    float: none !important;
    margin: 0 !important;
    padding: 5px 0 !important;
    background: none !important;
  }

  /* 彻底清除原站下拉箭头及所有伪元素横线 */
  header.site-header-cn .cn-main-menu > li::before,
  header.site-header-cn .cn-main-menu > li::after,
  header.site-header-cn .cn-main-menu > li > a::before,
  header.site-header-cn .cn-main-menu > li > a::after {
    content: none !important;
    display: none !important;
    background: none !important;
    border: none !important;
  }

  header.site-header-cn .cn-main-menu > li > a {
    display: inline-block !important;
    padding: 7px 14px !important;
    border-radius: 8px !important;
    font-size: 15.5px !important;
    font-weight: 600 !important;
    color: #1e293b !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
    background-color: transparent !important;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* 悬停效果：柔和浅蓝圆角背景 + 品牌蓝文字 */
  header.site-header-cn .cn-main-menu > li:hover > a {
    background-color: #f0f9ff !important;
    color: #2596d1 !important;
  }

  /* 现代悬浮圆角白卡下拉菜单（无生硬顶部蓝线） */
  header.site-header-cn .cn-main-menu > li > .vmegamenu {
    top: 100% !important;
    left: 0 !important;
    min-width: 192px !important;
    padding: 8px !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 10px !important;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.1) !important;
  }

  header.site-header-cn .cn-main-menu > li > .vmegamenu li {
    width: 100% !important;
    margin: 2px 0 !important;
    padding: 0 !important;
    border: none !important;
    background: none !important;
  }

  header.site-header-cn .cn-main-menu > li > .vmegamenu li a.title {
    display: block !important;
    padding: 9px 14px !important;
    border: none !important;
    border-radius: 6px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #334155 !important;
    line-height: 1.45 !important;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease, padding-left 0.18s ease;
  }

  header.site-header-cn .cn-main-menu > li > .vmegamenu li a.title:hover {
    background-color: #f0f9ff !important;
    color: #2596d1 !important;
    padding-left: 18px !important;
  }

  /* 右侧搜索图标 + 获取报价按钮 */
  header.site-header-cn .cn-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  header.site-header-cn .search_box {
    float: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  header.site-header-cn .cn-search-btn {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: #f1f5f9 !important;
    color: #334155 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 14px !important;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  header.site-header-cn .cn-search-btn:hover {
    background: #e0f2fe !important;
    color: #2596d1 !important;
  }

  header.site-header-cn .cn-quote-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    height: 36px !important;
    padding: 0 20px !important;
    border-radius: 18px !important;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%) !important;
    color: #ffffff !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    letter-spacing: 0.02em;
    white-space: nowrap !important;
    box-shadow: 0 4px 12px rgba(37, 150, 209, 0.24);
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  }

  header.site-header-cn .cn-quote-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 150, 209, 0.34);
    filter: brightness(1.04);
    color: #ffffff !important;
  }

  body > .height {
    height: 98px !important;
  }

  @media (max-width: 1200px) {
    header.site-header-cn .cn-header-inner {
      padding: 8px 16px !important;
      gap: 16px !important;
    }
    header.site-header-cn .cn-brand img {
      height: 50px !important;
    }
    header.site-header-cn .cn-main-menu {
      gap: 2px !important;
    }
    header.site-header-cn .cn-main-menu > li > a {
      padding: 6px 10px !important;
      font-size: 14.5px !important;
    }
    header.site-header-cn .cn-quote-btn {
      padding: 0 14px !important;
      font-size: 13.5px !important;
    }
    body > .height {
      height: 90px !important;
    }
  }

  @media (max-width: 991px) {
    header.site-header-cn .cn-header-inner {
      padding: 10px 56px 10px 16px !important;
    }
    header.site-header-cn .cn-brand img,
    header.site-header-cn.small .cn-brand img {
      height: 40px !important;
    }
    header.site-header-cn .cn-top-bar,
    header.site-header-cn .cn-quote-btn {
      display: none !important;
    }
    header.site-header-cn .cn-main-bar {
      width: auto !important;
      gap: 8px !important;
    }
    body > .height {
      height: 62px !important;
    }
  }
  
  /* 彻底拉平顶行左右高低错位 + 防止滚动裁切 */
  header.site-header-cn.small .header,
  header.site-header-cn.large .header {
    margin: 0 !important;
    padding: 0 !important;
    transform: none !important;
    height: auto !important;
  }

  header.site-header-cn .cn-nav-right {
    align-items: stretch !important;
  }

  header.site-header-cn .header_top.cn-top-bar,
  header.site-header-cn.small .header_top.cn-top-bar {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin: 0 0 4px 0 !important;
    padding: 0 0 6px 14px !important;
    position: static !important;
    top: auto !important;
    bottom: auto !important;
    transform: none !important;
    overflow: visible !important;
    box-sizing: border-box !important;
  }

  header.site-header-cn .cn-top-divider {
    display: none !important;
  }

  header.site-header-cn .cn-hotline,
  header.site-header-cn .header_top ul.menu.cn-top-menu {
    display: inline-flex !important;
    align-items: center !important;
    align-self: center !important;
    position: static !important;
    top: auto !important;
    bottom: auto !important;
    transform: none !important;
    height: 22px !important;
    line-height: 22px !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
  }

  header.site-header-cn .header_top ul.menu.cn-top-menu li {
    display: inline-flex !important;
    align-items: center !important;
    position: relative !important;
    top: 0 !important;
    bottom: auto !important;
    transform: none !important;
    height: 22px !important;
    line-height: 22px !important;
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    float: none !important;
  }

  header.site-header-cn .header_top ul.menu.cn-top-menu li a {
    display: inline-flex !important;
    align-items: center !important;
    position: static !important;
    top: auto !important;
    bottom: auto !important;
    transform: none !important;
    height: 22px !important;
    line-height: 22px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  header.site-header-cn .header_bottom.cn-main-bar {
    justify-content: space-between !important;
  }

  @media (max-width: 1200px) {
    header.site-header-cn .header_top.cn-top-bar,
    header.site-header-cn.small .header_top.cn-top-bar {
      padding-left: 10px !important;
    }
  }

  @media (max-width: 991px) {
    header.site-header-cn .cn-header-inner,
    header.site-header-cn.small .cn-header-inner {
      padding: 10px 56px 10px 16px !important;
    }
    header.site-header-cn .header_top.cn-top-bar,
    header.site-header-cn.small .header_top.cn-top-bar,
    header.site-header-cn.large .header_top.cn-top-bar,
    header.site-header-cn .cn-quote-btn {
      display: none !important;
    }
    header.site-header-cn .cn-nav-right {
      flex: 0 0 auto !important;
      align-items: flex-end !important;
    }
    header.site-header-cn .header_bottom.cn-main-bar {
      width: auto !important;
      justify-content: flex-end !important;
    }
  }
</style>