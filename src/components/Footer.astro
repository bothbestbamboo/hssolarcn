---
import { getCollection } from 'astro:content';
import { SITE, PRODUCT_CATEGORIES, POPULAR_TAGS } from '../data/site';

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;

const allNews = await getCollection('news', ({ data }) => data.type === 'news');
const latestThreeNews = allNews
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || b.data.id - a.data.id)
  .slice(0, 3);
---

<footer class="hs-footer">
  <!-- 页脚顶部：品牌 Logo 与联系方式 -->
  <div class="hs-footer-top">
    <div class="hs-footer-container hs-footer-top-inner">
      <div class="hs-footer-brand">
        <a href="/" class="hs-footer-logo" title={SITE.title}>
          <img
            src={SITE.logoLight}
            alt="宏晟光伏徽标"
            width="160"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="hs-footer-tagline">
          专注高效 N 型 TOPCon、HJT 异质结光伏组件、逆变器及锂电池储能系统的研发与规模化制造，为全球客户提供一站式绿色能源解决方案。
        </p>
      </div>

      <div class="hs-footer-contacts">
        <a rel="nofollow" href={`Tel:${SITE.phone}`} class="hs-contact-pill">
          <span class="hs-pill-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <span>
            <small>咨询热线 / 微信同号</small>
            <strong>{SITE.phone}</strong>
          </span>
        </a>

        <a rel="nofollow" href={`mailto:${SITE.email}`} class="hs-contact-pill">
          <span class="hs-pill-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span>
            <small>商务邮箱</small>
            <strong>{SITE.email}</strong>
          </span>
        </a>

        <div class="hs-contact-pill">
          <span class="hs-pill-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <span>
            <small>生产基地</small>
            <strong>{SITE.address}</strong>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 页脚主体：4 列均衡布局 -->
  <div class="hs-footer-main">
    <div class="hs-footer-container hs-footer-grid">
      <!-- 列 1：订阅与热门标签 -->
      <div class="hs-footer-col">
        <div class="hs-footer-heading">资讯订阅</div>
        <p class="hs-footer-note">
          订阅获取宏晟光伏最新产品规格书、组件新品发布及行业技术动态。
        </p>
        <form class="layui-form hs-sub-form" id="emailForm">
          <input type="hidden" name="access_key" value={SITE.web3formsKey} />
          <input type="hidden" name="subject" value="[宏晟光伏中文站] 页脚邮件订阅" />
          <input type="hidden" name="from_name" value="宏晟光伏中文官网" />
          <input name="message" type="hidden" value="中文站网页底部左下角订阅留资" />
          <input
            name="email"
            id="user_email"
            type="email"
            placeholder="请输入您的电子邮箱..."
            lay-verify="required|email"
            lay-reqText="请输入有效的电子邮箱"
          />
          <button type="submit" lay-submit lay-filter="send" aria-label="订阅">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </button>
        </form>

        <div class="hs-footer-tags">
          <span class="hs-tags-label">热门标签：</span>
          <div class="hs-tags-list">
            {POPULAR_TAGS.map((tag) => (
              <a href={`/category-tags-${tag.id}.html`}>{tag.name}</a>
            ))}
          </div>
        </div>
      </div>

      <!-- 列 2：产品中心 -->
      <div class="hs-footer-col">
        <div class="hs-footer-heading">产品中心</div>
        <ul class="hs-footer-links">
          {PRODUCT_CATEGORIES.map((cat) => (
            <li><a href={`/category-${cat.id}.html`}>{cat.name}</a></li>
          ))}
        </ul>
      </div>

      <!-- 列 3：快速导航 -->
      <div class="hs-footer-col">
        <div class="hs-footer-heading">快速导航</div>
        <ul class="hs-footer-links">
          <li><a href="/about-us.html">关于宏晟</a></li>
          <li><a href="/project.html">项目案例</a></li>
          <li><a href="/play-solar.html">光伏知识</a></li>
          <li><a href="/technical-services.html">技术服务</a></li>
          <li><a href="/faq.html">常见问题</a></li>
          <li><a href="/contact-us.html">联系我们</a></li>
        </ul>
      </div>

      <!-- 列 4：最新资讯 -->
      <div class="hs-footer-col">
        <div class="hs-footer-heading">最新新闻</div>
        <ul class="hs-footer-news">
          {latestThreeNews.map((item) => (
            <li>
              <a href={`/news-${item.data.id}.html`}>{item.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- 底部版权与友情链接 -->
  <div class="hs-footer-bottom">
    <div class="hs-footer-container">
      <div class="hs-footer-bottom-inner">
        <div class="hs-copyright">{SITE.copyright}</div>
        <div class="hs-legal-links">
          <a href="/privacy-policy.html">隐私政策</a>
          <a href="/contact-us.html">联系我们</a>
        </div>
      </div>

      {SITE.friendlyLinks && SITE.friendlyLinks.length > 0 && (
        <div class="hs-friendly-links">
          <span>友情链接：</span>
          {SITE.friendlyLinks.map((link) => (
            <a target="_blank" rel="noopener" href={link.href}>{link.name}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>

<!-- 返回顶部按钮（保留 .back_top 兼容 demo.js） -->
<a href="javascript:;" class="back_top hs-back-top" aria-label="返回顶部" title="返回顶部">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
</a>

<!-- 桌面端右侧极简联系悬浮栏 -->
<aside class="hs-side-dock" aria-label="快捷联系">
  <div class="hs-dock-item">
    <a rel="nofollow" href={`Tel:${SITE.phone}`} class="hs-dock-btn" aria-label="拨打电话">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </a>
    <div class="hs-dock-pop">
      <span>咨询热线</span>
      <a rel="nofollow" href={`Tel:${SITE.phone}`}>{SITE.phone}</a>
    </div>
  </div>

  <div class="hs-dock-item">
    <a rel="nofollow" href={`mailto:${SITE.email}`} class="hs-dock-btn" aria-label="发送邮件">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
    </a>
    <div class="hs-dock-pop">
      <span>商务邮箱</span>
      <a rel="nofollow" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>

  <div class="hs-dock-item">
    <button type="button" class="hs-dock-btn" aria-label="微信二维码">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3z"/><path d="M17 17h4v4h-4z"/></svg>
    </button>
    <div class="hs-dock-pop hs-dock-qr">
      <span>微信扫码咨询</span>
      <img src={SITE.wechatQr} alt="宏晟光伏微信二维码" width="120" height="120" loading="lazy" decoding="async" />
    </div>
  </div>
</aside>

<!-- 右下角现代极简询盘浮窗 -->
<div class="hs-float-widget" id="hsFloatWidget">
  <button
    type="button"
    class="hs-fab-btn"
    id="hsInquiryToggle"
    aria-expanded="false"
    aria-controls="hsInquiryPanel"
  >
    <span class="hs-fab-dot" aria-hidden="true"></span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span>快速询价</span>
  </button>

  <div class="hs-inquiry-panel" id="hsInquiryPanel" hidden>
    <div class="hs-inquiry-head">
      <div>
        <div class="hs-inquiry-title">获取厂家直供报价</div>
        <div class="hs-inquiry-sub">专业团队 12 小时内快速响应</div>
      </div>
      <button type="button" class="hs-inquiry-close" id="hsInquiryClose" aria-label="关闭询价窗口">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div class="hs-inquiry-body">
      <form method="post" id="floatingForm" class="layui-form hs-float-form" action="">
        <input type="hidden" name="access_key" value={SITE.web3formsKey} />
        <input type="hidden" name="subject" value="[宏晟光伏中文站] 右侧悬浮窗询盘" />
        <input type="hidden" name="from_name" value="宏晟光伏中文官网" />

        <div class="hs-field">
          <input
            lay-verify="required|email"
            lay-reqText="请输入有效的电子邮箱"
            name="email"
            type="email"
            placeholder="您的电子邮箱 *"
          />
        </div>
        <div class="hs-field">
          <input
            name="phone"
            type="text"
            placeholder="联系电话 / 微信（选填）"
          />
        </div>
        <div class="hs-field">
          <textarea
            lay-verify="required"
            lay-reqText="请输入您的询价详情"
            name="message"
            rows="4"
            placeholder="请填写产品型号、功率、采购数量及项目地区，以便为您精准报价 *"
          ></textarea>
        </div>
        <button type="submit" lay-submit lay-filter="contact" class="hs-submit-btn">
          立即提交询盘
        </button>
      </form>
    </div>
  </div>
</div>

<!-- 手机端 4 格现代底部导航栏 -->
<nav class="hs-mobile-bar" aria-label="移动端快捷操作">
  <a href="/" class="hs-mob-item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>主页</span>
  </a>
  <a href="/category.html" class="hs-mob-item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
    <span>产品</span>
  </a>
  <a rel="nofollow" href={`Tel:${SITE.phone}`} class="hs-mob-item">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>电话</span>
  </a>
  <button type="button" class="hs-mob-item hs-mob-quote" id="hsMobileQuoteBtn">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span>获取报价</span>
  </button>
</nav>

<style is:global>
  .hs-footer {
    background: #0f172a;
    color: #94a3b8;
    font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
      -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    line-height: 1.7;
  }

  .hs-footer *,
  .hs-footer *::before,
  .hs-footer *::after,
  .hs-float-widget *,
  .hs-side-dock *,
  .hs-mobile-bar * {
    box-sizing: border-box;
  }

  .hs-footer a {
    text-decoration: none;
  }

  .hs-footer-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hs-footer-top {
    padding: 46px 0 38px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hs-footer-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
  }

  .hs-footer-brand {
    max-width: 390px;
  }

  .hs-footer-logo {
    display: inline-block;
    margin-bottom: 14px;
  }

  .hs-footer-logo img {
    height: 44px;
    width: auto;
    display: block;
  }

  .hs-footer-tagline {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: #94a3b8;
  }

  .hs-footer-contacts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    gap: 14px;
  }

  .hs-contact-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  a.hs-contact-pill:hover {
    border-color: rgba(56, 189, 248, 0.5);
    background: rgba(37, 150, 209, 0.12);
    color: #ffffff;
  }

  .hs-pill-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(37, 150, 209, 0.18);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hs-contact-pill small {
    display: block;
    font-size: 11.5px;
    color: #94a3b8;
    line-height: 1.35;
  }

  .hs-contact-pill strong {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: #f8fafc;
    line-height: 1.4;
  }

  .hs-footer-main {
    padding: 46px 0;
  }

  .hs-footer-grid {
    display: grid;
    grid-template-columns: 1.45fr 0.9fr 0.9fr 1.25fr;
    gap: 40px;
  }

  .hs-footer-heading {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 18px;
  }

  .hs-footer-note {
    margin: 0 0 16px;
    font-size: 13.5px;
    line-height: 1.7;
    color: #94a3b8;
  }

  .hs-sub-form {
    position: relative;
    max-width: 340px;
  }

  .hs-sub-form input[type='email'] {
    width: 100%;
    height: 44px;
    padding: 0 52px 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-size: 13.5px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .hs-sub-form input[type='email']::placeholder {
    color: #94a3b8;
  }

  .hs-sub-form input[type='email']:focus {
    border-color: #38bdf8;
    background: rgba(255, 255, 255, 0.1);
  }

  .hs-sub-form button {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #2596d1;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .hs-sub-form button:hover {
    background: #38bdf8;
    color: #0f172a;
  }

  .hs-footer-tags {
    margin-top: 22px;
  }

  .hs-tags-label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 8px;
  }

  .hs-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hs-tags-list a {
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 12.5px;
    transition: all 0.2s ease;
  }

  .hs-tags-list a:hover {
    background: #2596d1;
    border-color: #2596d1;
    color: #ffffff;
  }

  .hs-footer-links,
  .hs-footer-news {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hs-footer-links li a,
  .hs-footer-news li a {
    color: #cbd5e1;
    font-size: 13.5px;
    line-height: 1.55;
    display: inline-block;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .hs-footer-links li a:hover,
  .hs-footer-news li a:hover {
    color: #38bdf8;
    transform: translateX(3px);
  }

  .hs-footer-news li a {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 版权与友情链接 */
  .hs-footer-bottom {
    background: #090e1a;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 20px 0;
  }

  .hs-footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: #64748b;
  }

  .hs-legal-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hs-legal-links a {
    color: #94a3b8;
    transition: color 0.2s ease;
  }

  .hs-legal-links a:hover {
    color: #38bdf8;
  }

  .hs-friendly-links {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-size: 12.5px;
    color: #64748b;
  }

  .hs-friendly-links a {
    color: #94a3b8;
    transition: color 0.2s ease;
  }

  .hs-friendly-links a:hover {
    color: #38bdf8;
  }

  /* 返回顶部按钮 */
  a.back_top.hs-back-top {
    position: fixed !important;
    right: 24px !important;
    bottom: 84px !important;
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: rgba(15, 23, 42, 0.85) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
