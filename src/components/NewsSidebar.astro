---
import { getCollection } from 'astro:content';
import { POPULAR_TAGS } from '../data/site';

interface Props {
  activeType?: 'news' | 'case' | 'solution' | 'knowledge';
}

const { activeType = 'news' } = Astro.props;

const latestNews = (await getCollection('news'))
  .filter((n) => n.data.type === 'news')
  .sort((a, b) => {
    const timeDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    return timeDiff !== 0 ? timeDiff : b.data.id - a.data.id;
  })
  .slice(0, 8);
---

<aside class="hs-sidebar" aria-label="资讯导航">
  <section class="hs-side-card">
    <div class="hs-side-head">
      <span>栏目分类</span>
    </div>
    <div class="hs-side-body">
      <ul class="hs-cat-menu">
        <li class={`hs-cat-item ${activeType === 'news' ? 'is-active' : ''}`}>
          <div class="hs-cat-row">
            <a href="/news.html" class="hs-cat-link">新闻与动态</a>
          </div>
        </li>
        <li class={`hs-cat-item ${activeType === 'case' ? 'is-active' : ''}`}>
          <div class="hs-cat-row">
            <a href="/project.html" class="hs-cat-link">工程项目案例</a>
          </div>
        </li>
        <li class={`hs-cat-item ${activeType === 'knowledge' ? 'is-active' : ''}`}>
          <div class="hs-cat-row">
            <a href="/play-solar.html" class="hs-cat-link">光伏知识库</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="hs-side-card">
    <div class="hs-side-head hs-side-head-light">
      <span>最新资讯</span>
    </div>
    <div class="hs-side-body">
      <ul class="hs-side-news">
        {latestNews.map((item) => (
          <li>
            <a href={`/news-${item.data.id}.html`}>
              <span class="hs-side-news-dot" aria-hidden="true"></span>
              <span>{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hs-side-card">
    <div class="hs-side-head hs-side-head-light">
      <span>热门标签</span>
    </div>
    <div class="hs-side-body">
      <div class="hs-side-tags">
        {POPULAR_TAGS.map((tag) => (
          <a href={`/category-tags-${tag.id}.html`}>{tag.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="hs-side-cta">
    <h4>正在筹备光伏项目？</h4>
    <p>免费获取组件规格书、系统选型建议及安徽生产基地厂家直供报价。</p>
    <a href="/contact-us.html">立即咨询报价</a>
  </section>
</aside>