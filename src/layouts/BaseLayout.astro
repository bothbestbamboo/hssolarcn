---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/markdown.css';
import '../styles/b2b-typography.css';
import '../styles/inner-pages.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  isHome?: boolean;
  preloadImage?: string;
  needLightbox?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  keywords = SITE.keywords,
  isHome = false,
  preloadImage,
  needLightbox = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- 核心首屏布局 CSS -->
    <link rel="stylesheet" href="/Public/theme/default/css/moban.css">
    <link rel="stylesheet" href="/Public/theme/default/css/bootstrap.css">
    <link rel="stylesheet" href="/Public/theme/default/css/swiper.css">
    <link rel="stylesheet" href="/Public/theme/default/css/style.css">

    <!-- 图标字体异步加载，不阻塞首屏绘制 -->
    <link
      rel="stylesheet"
      href="/Public/theme/default/css/font-awesome.min.css"
      media="print"
      onload="this.media='all'"
    >

    {needLightbox && (
      <link
        rel="stylesheet"
        href="/Public/theme/default/css/magnific-popup.css"
        media="print"
        onload="this.media='all'"
      >
    )}

    <noscript>
      <link rel="stylesheet" href="/Public/theme/default/css/font-awesome.min.css">
    </noscript>

    <slot name="head" />

    <!-- jQuery 使用 defer，确保在 Footer 脚本之前执行 -->
    <script is:inline defer src="/Public/Script/jquery.min.js"></script>
</head>
<body>
    <Header />
    <slot />
    <Footer isHome={isHome} />

    <style is:global>
      @media (max-width: 768px) {
        .phone img {
          width: auto !important;
          height: auto !important;
          max-width: 100% !important;
        }
      }

      .index_banner .slide-inner img,
      .swiper-banner .slide-inner img,
      .inner_banner img {
        width: 100% !important;
        height: auto !important;
        max-width: 100% !important;
        display: block;
      }

      @media (max-width: 991px) {
        .index_banner,
        .swiper-banner,
        .index_banner .swiper-slide,
        .index_banner .slide-inner,
        .inner_banner {
          height: auto !important;
          min-height: 0 !important;
        }
      }

      @media (min-width: 993px) {
        .modules .toggle_content {
          display: block !important;
        }
      }
    </style>
</body>
</html>