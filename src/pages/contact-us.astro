---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import { SITE } from '../data/site';

const CONTACT_BANNER = '/Public/theme/default/image/contact-us.jpg';
---

<BaseLayout
  title="联系我们 - 宏晟光伏: 太阳能板与光伏板的生产厂家"
  description="联系宏晟光伏获取太阳能板、N型TOPCon与HJT光伏组件、逆变器及储能系统厂家直销报价。"
  keywords="联系宏晟光伏, 太阳能板厂家, 光伏板报价"
  preloadImage={CONTACT_BANNER}
>
  <InnerBanner
    title="联系我们"
    subtitle="欢迎咨询高效光伏组件、逆变器及储能系统厂家直供报价、产品规格书或定制化电站方案。"
    bannerImg={CONTACT_BANNER}
    bannerAlt="联系宏晟光伏"
    breadcrumbs={[{ label: '联系我们' }]}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container">
      <!-- 1. 顶部三列现代联系方式卡 -->
      <div class="hs-con-cards">
        <a rel="nofollow" href={`Tel:${SITE.phone}`} class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <div class="hs-con-label">咨询热线 / 微信同号</div>
            <div class="hs-con-value">{SITE.phone}</div>
            <div class="hs-con-note">工厂直连商务与技术专员</div>
          </div>
        </a>

        <a rel="nofollow" href={`mailto:${SITE.email}`} class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <div class="hs-con-label">电子邮箱</div>
            <div class="hs-con-value">{SITE.email}</div>
            <div class="hs-con-note">12 小时内快速响应报价</div>
          </div>
        </a>

        <div class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="hs-con-label">生产基地地址</div>
            <div class="hs-con-value">{SITE.address}</div>
            <div class="hs-con-note">欢迎预约实地考察与验厂</div>
          </div>
        </div>
      </div>

      <!-- 2. 主体双栏：左询盘表单 + 右微信二维码与服务卡片 -->
      <div class="hs-con-main">
        <div class="hs-surface-card hs-con-form-card">
          <span class="hs-con-eyebrow">ONLINE INQUIRY · 在线留言</span>
          <h2>获取项目与产品报价</h2>
          <p class="hs-con-desc">
            如果您对我们的太阳能组件、逆变器或储能产品感兴趣，请填写以下信息，我们的销售与工程团队将在 12 小时内为您提供详细报价与规格书。
          </p>

          <form class="layui-form hs-con-form" method="post" id="contactPageForm">
            <input type="hidden" name="access_key" value={SITE.web3formsKey} />
            <input type="hidden" name="subject" value="[宏晟光伏中文站] 联系我们页面询盘" />
            <input type="hidden" name="from_name" value="宏晟光伏中文官网" />

            <div class="hs-con-field">
              <label for="con-email">电子邮箱 *</label>
              <input
                id="con-email"
                lay-verify="required|email"
                lay-reqText="请输入有效的电子邮箱"
                type="email"
                name="email"
                placeholder="请输入您的工作或个人邮箱"
              />
            </div>

            <div class="hs-con-field">
              <label for="con-phone">联系电话 / 微信</label>
              <input
                id="con-phone"
                type="text"
                name="phone"
                placeholder="填写手机号或微信号，方便快速沟通"
              />
            </div>

            <div class="hs-con-field">
              <label for="con-msg">询价与项目详情 *</label>
              <textarea
                id="con-msg"
                lay-verify="required"
                lay-reqText="请输入您的询价详情"
                rows="6"
                maxlength="3000"
                name="message"
                placeholder="请输入您所需的产品型号（如 700W+ 异质结、N型组件、储能系统等）、功率、采购数量及项目所在地区..."
              ></textarea>
            </div>

            <button class="hs-con-submit" lay-submit lay-filter="contact" type="submit">
              提交留言询盘
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </form>
        </div>

        <div class="hs-con-right">
          <div class="hs-surface-card hs-con-wechat">
            <img
              src={SITE.wechatQr}
              alt="宏晟光伏微信二维码"
              width="112"
              height="112"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>微信扫码即时沟通</h3>
              <p>扫描左侧二维码添加宏晟光伏销售专员微信，实时获取产品电子画册、库存排期及工厂直供价格。</p>
            </div>
          </div>

          <div class="hs-con-services">
            <a href="/category.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-1.jpg" alt="客户需求" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>客户需求对接</h3>
                <p>满足客户对太阳能电池、光伏组件、逆变器及储能系统等全系列光伏产品的定制与采购需求。</p>
              </div>
            </a>

            <a href="/technical-services.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-2.jpg" alt="技术支持" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>专业技术支持</h3>
                <p>提供一对一技术咨询，解答光伏产品选型、系统图纸设计与安装调试中的各类工程问题。</p>
              </div>
            </a>

            <a href="/faq.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-3.jpg" alt="售后服务" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>完善售后服务</h3>
                <p>建立覆盖质保响应、远程诊断、配件更换及系统运维升级的全周期售后保障体系。</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-con-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .hs-con-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  a.hs-con-card:hover {
    transform: translateY(-3px);
    border-color: #93c5fd;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .hs-con-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #eff6ff;
    color: #2596d1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hs-con-label {
    font-size: 12.5px;
    font-weight: 700;
    color: #2596d1;
    margin-bottom: 4px;
  }

  .hs-con-value {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.45;
    word-break: break-word;
  }

  .hs-con-note {
    font-size: 13px;
    color: #64748b;
    margin-top: 3px;
  }

  .hs-con-main {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 28px;
    align-items: start;
  }

  .hs-con-eyebrow {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #2596d1;
    margin-bottom: 6px;
  }

  .hs-con-form-card h2 {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
  }

  .hs-con-desc {
    margin: 0 0 24px;
    font-size: 14.5px;
    line-height: 1.72;
    color: #64748b;
  }

  .hs-con-field {
    margin-bottom: 16px;
  }

  .hs-con-field label {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 6px;
  }

  .hs-con-field input,
  .hs-con-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-field input:focus,
  .hs-con-field textarea:focus {
    background: #ffffff;
    border-color: #2596d1;
    box-shadow: 0 0 0 3px rgba(37, 150, 209, 0.14);
  }

  .hs-con-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 28px;
    border-radius: 999px;
    border: none;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(37, 150, 209, 0.26);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(37, 150, 209, 0.36);
  }

  .hs-con-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hs-con-wechat {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
  }

  .hs-con-wechat img {
    width: 104px;
    height: 104px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .hs-con-wechat h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
  }

  .hs-con-wechat p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.68;
    color: #64748b;
  }

  .hs-con-services {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hs-con-srv-card {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-srv-card:hover {
    transform: translateY(-2px);
    border-color: #93c5fd;
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
  }

  .hs-con-srv-img {
    height: 100%;
    min-height: 112px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .hs-con-srv-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hs-con-srv-body {
    padding: 16px 18px;
  }

  .hs-con-srv-body h3 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    transition: color 0.18s ease;
  }

  .hs-con-srv-card:hover .hs-con-srv-body h3 {
    color: #2596d1;
  }

  .hs-con-srv-body p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: #64748b;
  }

  @media (max-width: 991px) {
    .hs-con-cards,
    .hs-con-main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hs-con-wechat {
      flex-direction: column;
      text-align: center;
    }
    .hs-con-srv-card {
      grid-template-columns: 1fr;
    }
    .hs-con-srv-img {
      aspect-ratio: 16 / 9;
    }
  }
</style>