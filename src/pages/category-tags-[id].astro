---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import { POPULAR_TAGS } from '../data/site';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');

  return POPULAR_TAGS.map((tag) => {
    const matched = allProducts
      .filter((p) => {
        const inTags = (p.data.tags || []).some(
          (t: string) => t.toLowerCase() === tag.name.toLowerCase()
        );
        const inTitle = p.data.title.toLowerCase().includes(tag.name.toLowerCase());
        return inTags || inTitle;
      })
      .sort((a, b) => a.data.id - b.data.id);

    return {
      params: { id: String(tag.id) },
      props: { tag, products: matched },
    };
  });
}

const { tag, products } = Astro.props;
---

<BaseLayout
  title={`${tag.name}相关产品 - 宏晟光伏`}
  description={`浏览宏晟光伏${tag.name}系列太阳能板、组件与配套系统方案。`}
>
  <InnerBanner
    title={`${tag.name} 相关产品`}
    subtitle={`按热门标签筛选宏晟光伏 ${tag.name} 系列产品与配套硬件。`}
    bannerImg="/Public/theme/default/picture/product.jpg"
    breadcrumbs={[
      { label: '产品中心', href: '/category.html' },
      { label: tag.name },
    ]}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container">
      <div class="hs-tag-switcher">
        <span class="hs-tag-label">热门标签：</span>
        {POPULAR_TAGS.map((item) => (
          <a
            href={`/category-tags-${item.id}.html`}
            class={`hs-tag-pill ${item.id === tag.id ? 'is-active' : ''}`}
          >
            {item.name}
          </a>
        ))}
        <a href="/category.html" class="hs-tag-all">查看全部产品 →</a>
      </div>

      {products.length > 0 ? (
        <div class="hs-pro-grid hs-pro-grid-4">
          {products.map((item) => (
            <article class="hs-pro-card">
              <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-media">
                <span class="hs-pro-badge">{tag.name}</span>
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="hs-pro-body">
                <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-title">
                  {item.data.title}
                </a>
                <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-cta">
                  查看参数与报价 <span>→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="hs-empty-box">
          暂未找到“{tag.name}”标签下的相关产品。
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hs-tag-switcher {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    margin-bottom: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }
  .hs-tag-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #0f172a;
    margin-right: 4px;
  }
  .hs-tag-pill {
    padding: 6px 16px;
    border-radius: 999px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    font-size: 13.5px;
    font-weight: 600;
    color: #334155;
    transition: all 0.18s ease;
  }
  .hs-tag-pill:hover,
  .hs-tag-pill.is-active {
    background: #2596d1;
    border-color: #2596d1;
    color: #ffffff;
  }
  .hs-tag-all {
    margin-left: auto;
    font-size: 13.5px;
    font-weight: 600;
    color: #2596d1;
  }
  .hs-tag-all:hover {
    color: #1a7bb9;
  }
</style>