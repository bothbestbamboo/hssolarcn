---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import NewsListView from '../components/NewsListView.astro';

const items = (await getCollection('news'))
  .filter((n) => n.data.type === 'news')
  .sort((a, b) => {
    const timeDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    return timeDiff !== 0 ? timeDiff : b.data.id - a.data.id;
  });
---

<BaseLayout
  title="新闻 - 宏晟光伏: 太阳能板与光伏板的生产厂家"
  description="宏晟光伏最新行业资讯、光伏电站运维技术文章与公司动态。"
>
  <InnerBanner
    title="新闻"
    bannerImg="/Public/theme/default/image/news.jpg"
    bannerAlt="新闻"
    breadcrumbs={[
      { label: '关于宏晟', href: '/about-us.html' },
      { label: '新闻' },
    ]}
  />

  <NewsListView items={items} activeType="news" buttonText="查看更多" />
</BaseLayout>