---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, HOME_BANNERS, PRODUCT_CATEGORIES } from '../data/site';
import { getTopCategories } from '../data/categories';

const allProducts = await getCollection('products');
const hotProducts = allProducts
  .filter((p) => p.data.isHot)
  .sort((a, b) => a.data.id - b.data.id);
const displayProducts =
  hotProducts.length > 0
    ? hotProducts
    : [...allProducts].sort((a, b) => a.data.id - b.data.id).slice(0, 6);

const allNews = await getCollection('news');

const cases = allNews
  .filter((n) => n.data.type === 'case' || n.data.type === 'project')
  .sort((a, b) => a.data.id - b.data.id);

const solutions = allNews
  .filter((n) => n.data.type === 'solution')
  .sort((a, b) => a.data.id - b.data.id)
  .slice(0, 2);

const knowledge = allNews
  .filter((n) => n.data.type === 'knowledge')
  .sort((a, b) => a.data.id - b.data.id)
  .slice(0, 4);

const latestNews = allNews
  .filter((n) => n.data.type === 'news')
  .sort((a, b) => {
    const timeDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    return timeDiff !== 0 ? timeDiff : b.data.id - a.data.id;
  })
  .slice(0, 3);

const topCategories = getTopCategories().map((cat) => {
  const match = PRODUCT_CATEGORIES.find((p) => p.id === cat.id);
  const subPreview = match?.children.slice(0, 3).map((c) => c.name).join(' · ') || '';
  return { ...cat, subPreview };
});

const factoryStats = [
  { value: '10+', label: '年光伏智造经验', sub: '全自动化智能产线' },
  { value: '750Wp', label: '单板最高峰值功率', sub: 'N 型 TOPCon & HJT 异质结' },
  { value: '110+', label: '产品远销国家与地区', sub: '覆盖全球海运物流网络' },
  { value: '2,000+', label: '全球合作客户', sub: '通过 TÜV / Intertek 认证' },
];

const formatDate = (dateStr?: string) => (dateStr ? dateStr.slice(0, 10) : '');
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  keywords={SITE.keywords}
  isHome={true}
  preloadImage={HOME_BANNERS[0].img}
>
  <div class="height"></div>

  <main class="hs-home">
    <!-- 1. 首屏 Hero 轮播（轻透遮罩，适配无文字高清底图） -->
    <section class="hs-hero-wrap" aria-label="核心展示">
      <div class="swiper-banner index_banner hs-hero">
        <div class="swiper-wrapper">
          {HOME_BANNERS.map((banner, idx) => (
            <div class="swiper-slide">
              <div class="slide-inner">
                <picture>
                  <img
                    class="hs-hero-bg"
                    src={banner.img}
                    alt={banner.alt}
                    width="1920"
                    height="720"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : 'low'}
                    decoding="async"
                  />
                </picture>
                <div class="hs-hero-overlay" aria-hidden="true"></div>
                <div class="hs-hero-content">
                  <div class="hs-container">
                    <div class="hs-hero-box">
                      <span class="hs-hero-badge">{banner.badge}</span>
                      {idx === 0 ? (
                        <h1 class="hs-hero-title">
                          {banner.title}
                          <span>{banner.highlight}</span>
                        </h1>
                      ) : (
                        <h2 class="hs-hero-title">
                          {banner.title}
                          <span>{banner.highlight}</span>
                        </h2>
                      )}
                      <p class="hs-hero-desc">{banner.subtitle}</p>
                      <div class="hs-hero-actions">
                        <a href={banner.primaryLink} class="hs-btn hs-btn-primary">
                          {banner.primaryText}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                        <a href={banner.secondaryLink} class="hs-btn hs-btn-glass">
                          {banner.secondaryText}
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="swiper-button-prev" aria-label="上一张"></div>
        <div class="swiper-button-next" aria-label="下一张"></div>
        <div class="swiper-pagination"></div>
      </div>
    </section>

    <!-- 2. 工厂实力信任带 -->
    <section class="hs-stats-section" aria-label="企业实力数据">
      <div class="hs-container">
        <div class="hs-stats-grid">
          {factoryStats.map((stat) => (
            <div class="hs-stat-item">
              <div class="hs-stat-value">{stat.value}</div>
              <div class="hs-stat-label">{stat.label}</div>
              <div class="hs-stat-sub">{stat.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. 六大核心产品矩阵 -->
    <section class="hs-section hs-section-muted">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">PRODUCT PORTFOLIO · 产品矩阵</span>
            <h2 class="hs-title">一站式光伏与储能供应链</h2>
            <p class="hs-subtitle">
              从高效光伏组件、智能逆变器到锂电池储能、安装支架及全套系统配件，厂家直供满足多元场景需求。
            </p>
          </div>
          <a href="/category.html" class="hs-link-more">
            查看全部分类
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-cat-grid">
          {topCategories.map((cat) => (
            <a href={`/category-${cat.id}.html`} class="hs-cat-card">
              <div class="hs-cat-icon" aria-hidden="true">
                {cat.id === 1 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 11h18"/><path d="M9 4v14"/><path d="M15 4v14"/><path d="M8 21h8"/><path d="M12 18v3"/></svg>
                )}
                {cat.id === 3 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M13 7l-4 5h4l-1 5 4-5h-4l1-5z"/></svg>
                )}
                {cat.id === 4 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="7" width="18" height="11" rx="2"/><path d="M22 11v3"/><path d="M6 11v3"/><path d="M10 11v3"/><path d="M14 11v3"/></svg>
                )}
                {cat.id === 5 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                )}
                {cat.id === 6 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M2 20h20"/><path d="m4 14 16-6"/><path d="M7 13v7"/><path d="M17 9v11"/></svg>
                )}
                {cat.id === 7 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
                )}
              </div>
              <div class="hs-cat-body">
                <h3>{cat.name}</h3>
                {cat.subPreview && <div class="hs-cat-tags">{cat.subPreview}</div>}
                <p>{cat.description}</p>
              </div>
              <span class="hs-cat-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. 热门产品轮播（保留 .cat_content / .pro_scrollbar 兼容 demo.js） -->
    <section class="hs-section cat_content hs-products">
      <div class="hs-container">
        <div class="hs-section-head hs-head-center">
          <span class="hs-eyebrow">HOT PRODUCTS · 热门产品</span>
          <h2 class="hs-title">主推光伏组件与核心设备</h2>
          <p class="hs-subtitle">
            作为专业的太阳能系统供应商，宏晟光伏专注打造高发电量、高可靠性的太阳能光伏组件与成套系统。
          </p>
        </div>

        <div class="hs-swiper-shell">
          <div class="swiper pro_scrollbar">
            <div class="swiper-wrapper">
              {displayProducts.map((item) => (
                <div class="swiper-slide">
                  <article class="hs-product-card">
                    <a href={`/product-detail-${item.data.id}.html`} class="hs-product-media">
                      {item.data.tags && item.data.tags.length > 0 && (
                        <span class="hs-product-tag">{item.data.tags[0]}</span>
                      )}
                      <picture>
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </a>
                    <div class="hs-product-body">
                      <a href={`/product-detail-${item.data.id}.html`} class="hs-product-title">
                        {item.data.title}
                      </a>
                      <a href={`/product-detail-${item.data.id}.html`} class="hs-product-cta">
                        查看参数与报价 <span>→</span>
                      </a>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-button-prev hs-nav-btn" aria-label="上一个产品"></div>
          <div class="swiper-button-next hs-nav-btn" aria-label="下一个产品"></div>
          <div class="swiper-pagination hs-dots"></div>
        </div>

        <div class="hs-center-action">
          <a href="/category.html" class="hs-btn hs-btn-primary">
            查看更多产品
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. 为什么选择宏晟光伏（2x2 均衡现代卡片） -->
    <section class="hs-section hs-section-muted hs-why">
      <div class="hs-container">
        <div class="hs-section-head hs-head-center">
          <span class="hs-eyebrow">WHY HOMESUN · 品牌优势</span>
          <h2 class="hs-title">十年深耕，成就可靠品质</h2>
          <p class="hs-subtitle">
            从高功率组件研发、全流程品控检测到全球项目交付，我们持续为客户创造更高发电收益。
          </p>
        </div>

        <div class="hs-why-grid">
          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">01</span>
              <picture>
                <img
                  src="/Public/theme/default/picture/1721045333_3vVNWtUjmd.png"
                  alt="高性能、实惠的价格"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>高功率输出，厂家直供性价比</h3>
              <p>
                宏晟光伏 N 型与异质结组件单板峰值功率可突破 700Wp，在有限安装面积内带来更高发电量。我们提供从方案分析、系统设计到优质元器件供应的一站式服务，让清洁太阳能更具投资回报。
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">02</span>
              <picture>
                <img
                  src="/Public/theme/default/picture/1721095476_ZCdp1MpELP.png"
                  alt="严苛的品控体系"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>全流程严苛质量控制</h3>
              <p>
                从原材料检验、自动化制造、EL 检测、海运包装到项目落地，宏晟新能源在每一个环节都执行严格质控标准，产品通过 TÜV 和 Intertek 等国际权威独立机构检验认证。
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">03</span>
              <picture>
                <img
                  src="/Public/theme/default/picture/1721808780_1USSy0dTM9.png"
                  alt="专业技术团队支持"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>资深制造与工程技术团队</h3>
              <p>
                依托经验丰富的工艺制造与光伏工程人才队伍，我们不仅确保组件品质稳定，更为客户提供从组件选型、逆变器配比到整套光储方案的专业技术支持与售后响应。
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">04</span>
              <picture>
                <img
                  src="/Public/theme/default/picture/1721095611_eUbkVjMtB9.png"
                  alt="践行企业社会责任"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>践行绿色能源社会责任</h3>
              <p>
                “品味太阳”不仅是宏晟光伏的品牌理念，更是我们的长期追求。我们持续向当地学校捐赠太阳能发电系统、赞助青少年体育赛事，并开展光伏科普教育，与全球伙伴共创可持续未来。
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. 工程项目案例轮播（保留 .case_content / .case_scrollbar 兼容 demo.js） -->
    <section class="hs-section case_content hs-cases">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">CASE STUDIES · 工程案例</span>
            <h2 class="hs-title">全球项目案例展示</h2>
            <p class="hs-subtitle">
              宏晟光伏组件与储能系统已稳定运行于全球 100 多个国家和地区的户用、工商业与地面电站项目。
            </p>
          </div>
          <a href="/project.html" class="hs-link-more">
            查看全部案例
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-swiper-shell">
          <div class="swiper case_scrollbar">
            <div class="swiper-wrapper">
              {cases.map((item) => (
                <div class="swiper-slide">
                  <article class="hs-case-card">
                    <a href={`/news-${item.data.id}.html`} class="hs-case-media">
                      <picture>
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                      <div class="hs-case-scrim" aria-hidden="true"></div>
                      <div class="hs-case-overlay">
                        <h3>{item.data.title}</h3>
                        <p>{item.data.summary}</p>
                        <span class="hs-case-link">查看项目详情 →</span>
                      </div>
                    </a>
                  </article>
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-button-prev hs-nav-btn" aria-label="上一个案例"></div>
          <div class="swiper-button-next hs-nav-btn" aria-label="下一个案例"></div>
          <div class="swiper-pagination hs-dots"></div>
        </div>
      </div>
    </section>

    <!-- 7. 系统解决方案 -->
    <section class="hs-section hs-section-dark hs-solutions">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow hs-eyebrow-light">SOLUTIONS · 系统方案</span>
            <h2 class="hs-title hs-title-light">定制化光储系统解决方案</h2>
            <p class="hs-subtitle hs-subtitle-light">
              服务全球 110 个国家 2,000 余家客户，专注提供高可靠硬件与全生命周期专业技术支持。
            </p>
          </div>
          <a href="/category-5.html" class="hs-link-more hs-link-light">
            探索全部方案
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-solution-grid">
          {solutions.map((item) => (
            <article class="hs-solution-card">
              <a href={`/news-${item.data.id}.html`} class="hs-solution-link">
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div class="hs-solution-scrim" aria-hidden="true"></div>
                <div class="hs-solution-body">
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="hs-solution-btn">
                    查看方案详情
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. 光伏知识库 -->
    <section class="hs-section hs-section-muted hs-knowledge">
      <div class="hs-container">
        <div class="hs-knowledge-layout">
          <div class="hs-knowledge-intro">
            <span class="hs-eyebrow">KNOWLEDGE HUB · 光伏知识</span>
            <h2 class="hs-title">与 <span>宏晟光伏</span> 一起成为太阳能专家</h2>
            <p class="hs-subtitle">
              深入探索光伏发电原理、系统选型技巧、离网储能配置与全球清洁能源前沿技术，助力项目科学决策。
            </p>
            <a href="/play-solar.html" class="hs-btn hs-btn-primary">
              进入光伏知识库
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="hs-knowledge-grid">
            {knowledge.map((item) => (
              <article class="hs-know-card">
                <a href={`/news-${item.data.id}.html`} class="hs-know-media">
                  <picture>
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
                <div class="hs-know-body">
                  <a href={`/news-${item.data.id}.html`} class="hs-know-title">
                    {item.data.title}
                  </a>
                  <a href={`/news-${item.data.id}.html`} class="hs-know-more">阅读指南 →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 9. 最新新闻资讯 -->
    <section class="hs-section hs-news">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">NEWS &amp; INSIGHTS · 最新动态</span>
            <h2 class="hs-title">新闻与行业资讯</h2>
            <p class="hs-subtitle">
              聚焦全球光伏行业趋势、技术深度解读与宏晟光伏工厂最新动态。
            </p>
          </div>
          <a href="/news.html" class="hs-link-more">
            查看全部资讯
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-news-grid">
          {latestNews.map((item) => (
            <article class="hs-news-card">
              <a href={`/news-${item.data.id}.html`} class="hs-news-media">
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="hs-news-body">
                <div class="hs-news-date">{formatDate(item.data.date)}</div>
                <a href={`/news-${item.data.id}.html`} class="hs-news-title">
                  {item.data.title}
                </a>
                <p class="hs-news-summary">{item.data.summary}</p>
                <a href={`/news-${item.data.id}.html`} class="hs-news-more">
                  阅读全文
