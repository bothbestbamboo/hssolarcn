---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import ProductSidebar from '../components/ProductSidebar.astro';
import { CATEGORIES } from '../data/categories';
import { SITE } from '../data/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: String(product.data.id) },
    props: { product, allProducts: products },
  }));
}

const { product, allProducts } = Astro.props;
const { Content } = await render(product);

const gallery = product.data.gallery?.length
  ? product.data.gallery
  : [product.data.image];

const primaryCatId = product.data.categoryIds?.[0];
const primaryCat = CATEGORIES.find((c) => c.id === primaryCatId);
const activeSubCatId =
  product.data.categoryIds?.find((cid: number) => cid !== 1) || primaryCatId;

const relatedProducts = allProducts
  .filter((p) => p.data.id !== product.data.id)
  .sort((a, b) => a.data.id - b.data.id)
  .slice(0, 4);
---

<BaseLayout
  title={product.data.seoTitle || `${product.data.title} - 宏晟光伏`}
  description={product.data.description || product.data.summary || product.data.title}
  keywords={product.data.keywords || product.data.tags?.join(', ')}
>
  <InnerBanner
    title={primaryCat ? primaryCat.name : '产品详情'}
    bannerImg={primaryCat?.bannerImg || '/Public/theme/default/picture/product.jpg'}
    isDetail={true}
    breadcrumbs={[
      { label: '产品中心', href: '/category.html' },
      ...(primaryCat ? [{ label: primaryCat.name, href: `/category-${primaryCat.id}.html` }] : []),
      { label: product.data.title },
    ]}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container hs-two-col">
      <!-- 左侧产品导航 -->
      <ProductSidebar activeCategoryId={activeSubCatId} />

      <!-- 右侧详情主体 -->
      <div class="hs-main-col hs-pd-stack">
        <!-- 1. 主图相册与核心参数卡 -->
        <div class="hs-surface-card hs-pd-hero">
          <div class="hs-pd-gallery">
            <div class="swiper hs-pd-main-swiper" id="pro_img_gallery">
              <div class="swiper-wrapper">
                {gallery.map((img: string, idx: number) => (
                  <div class="swiper-slide">
                    <div class="hs-pd-stage">
                      <img
                        src={img}
                        alt={`${product.data.title} - ${idx + 1}`}
                        loading={idx === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {gallery.length > 1 && (
              <div class="swiper hs-pd-thumb-swiper" id="pro_img_thumbs">
                <div class="swiper-wrapper">
                  {gallery.map((img: string, idx: number) => (
                    <div class="swiper-slide">
                      <div class="hs-pd-thumb">
                        <img
                          src={img}
                          alt={`${product.data.title} 缩略图 ${idx + 1}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="hs-pd-info">
            {product.data.tags && product.data.tags.length > 0 && (
              <div class="hs-pd-tags">
                {product.data.tags.map((t: string) => (
                  <span class="hs-pd-tag">{t}</span>
                ))}
              </div>
            )}

            <h1 class="hs-pd-title">{product.data.title}</h1>

            {product.data.summary && (
              <p class="hs-pd-summary">{product.data.summary}</p>
            )}

            {product.data.specs && product.data.specs.length > 0 && (
              <table class="hs-pd-specs">
                <tbody>
                  {product.data.specs.map((spec: { label: string; value: string }) => (
                    <tr>
                      <th>{spec.label}</th>
                      <td>{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            <div class="hs-pd-highlights">
              <span>TÜV &amp; Intertek 认证</span>
              <span>安徽工厂直供</span>
              <span>支持 OEM / 全球出口</span>
            </div>

            <div class="hs-pd-actions">
              <a href="#product-inquiry" class="hs-pd-btn-primary">
                获取该型号报价
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              {product.data.datasheet ? (
                <a href={product.data.datasheet} target="_blank" class="hs-pd-btn-outline">
                  下载规格书 (PDF)
                </a>
              ) : (
                <a
                  rel="nofollow"
                  href={`mailto:${SITE.email}?subject=${encodeURIComponent(`索取产品规格书：${product.data.title}`)}`}
                  class="hs-pd-btn-outline"
                >
                  索取 PDF 规格书
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- 2. 产品详情与技术参数正文 -->
        <div class="hs-surface-card">
          <div class="hs-card-bar">
            <h2>产品详情与技术规格</h2>
          </div>
          <div class="markdown-body phone">
            <Content />
          </div>
        </div>

        <!-- 3. 页内专属询盘表单（自动关联当前产品型号） -->
        <div class="hs-surface-card hs-pd-inquiry" id="product-inquiry">
          <div class="hs-pd-inq-head">
            <h2>咨询该型号厂家报价</h2>
            <p>
              当前产品：<strong>{product.data.title}</strong> — 请留下您的联系方式与需求功率/数量，专业销售工程师将在 12 小时内回复报价与规格书。
            </p>
          </div>

          <form class="layui-form hs-pd-form" method="post" id="productInquiryForm">
            <input type="hidden" name="access_key" value={SITE.web3formsKey} />
            <input type="hidden" name="subject" value={`[宏晟光伏中文站] 产品询盘：${product.data.title}`} />
            <input type="hidden" name="from_name" value="宏晟光伏中文官网" />
            <input type="hidden" name="product_model" value={product.data.title} />

            <div class="hs-pd-form-row">
              <div class="hs-pd-field">
                <label for="pd-email">电子邮箱 *</label>
                <input
                  id="pd-email"
                  type="email"
                  name="email"
                  lay-verify="required|email"
                  lay-reqText="请输入有效的电子邮箱"
                  placeholder="请输入您的工作邮箱"
                />
              </div>
              <div class="hs-pd-field">
                <label for="pd-phone">联系电话 / 微信</label>
                <input
                  id="pd-phone"
                  type="text"
                  name="phone"
                  placeholder="填写手机号或微信号，方便快速沟通"
                />
              </div>
            </div>

            <div class="hs-pd-field">
              <label for="pd-msg">采购与项目需求 *</label>
              <textarea
                id="pd-msg"
                name="message"
                rows="4"
                lay-verify="required"
                lay-reqText="请输入您的询价详情"
                placeholder="请说明您的预计装机容量、采购数量、项目所在地区以及是否需要配套逆变器/储能/支架等。"
              ></textarea>
            </div>

            <button type="submit" lay-submit lay-filter="contact" class="hs-pd-btn-primary">
              提交产品询盘
            </button>
          </form>
        </div>

        <!-- 4. 相关产品推荐 -->
        {relatedProducts.length > 0 && (
          <div class="hs-pd-related">
            <div class="hs-pd-related-head">
              <h2>相关产品推荐</h2>
              <a href="/category.html">查看全部 →</a>
            </div>
            <div class="hs-pd-related-grid">
              {relatedProducts.map((item) => (
                <article class="hs-pro-card">
                  <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-media">
                    <picture>
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </a>
                  <div class="hs-pro-body">
                    <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-title">
                      {item.data.title}
                    </a>
                    <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-cta">
                      查看详情 <span>→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-pd-stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hs-pd-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: 34px;
    align-items: start;
  }

  .hs-pd-gallery {
    min-width: 0;
  }

  .hs-pd-main-swiper {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .hs-pd-stage {
    aspect-ratio: 4 / 3;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .hs-pd-stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .hs-pd-thumb-swiper .swiper-slide {
    cursor: pointer;
    border-radius: 8px;
    border: 2px solid #e2e8f0;
    overflow: hidden;
    background: #ffffff;
    transition: border-color 0.18s ease;
  }

  .hs-pd-thumb-swiper .swiper-slide.swiper-slide-thumb-active,
  .hs-pd-thumb-swiper .swiper-slide:hover {
    border-color: #2596d1;
  }

  .hs-pd-thumb {
    height: 62px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hs-pd-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .hs-pd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .hs-pd-tag {
    padding: 4px 12px;
    border-radius: 999px;
    background: #eff6ff;
    color: #1a7bb9;
    font-size: 12px;
    font-weight: 700;
  }

  .hs-pd-title {
    margin: 0 0 14px;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.38;
    color: #0f172a;
  }

  .hs-pd-summary {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.75;
    color: #475569;
  }

  .hs-pd-specs {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 18px;
    font-size: 14px;
  }

  .hs-pd-specs th,
  .hs-pd-specs td {
    padding: 10px 12px;
    border: 1px solid #e2e8f0;
    text-align: left;
  }

  .hs-pd-specs th {
    width: 42%;
    background: #f8fafc;
    color: #0f172a;
    font-weight: 600;
  }

  .hs-pd-specs td {
    color: #334155;
    background: #ffffff;
  }

  .hs-pd-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }

  .hs-pd-highlights span {
    padding: 5px 12px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    font-size: 12.5px;
    font-weight: 600;
    color: #334155;
  }

  .hs-pd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hs-pd-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 24px;
    border-radius: 999px;
    border: none;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%);
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(37, 150, 209, 0.24);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-pd-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(37, 150, 209, 0.34);
    color: #ffffff;
  }

  .hs-pd-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-size: 14px;
    font-weight: 600;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .hs-pd-btn-outline:hover {
    border-color: #2596d1;
    color: #2596d1;
    background: #f0f9ff;
  }

  .hs-card-bar {
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid #e2e8f0;
  }

  .hs-card-bar h2,
  .hs-pd-inq-head h2,
  .hs-pd-related-head h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
  }

  .hs-pd-inquiry {
    scroll-margin-top: 110px;
    border-top: 4px solid #2596d1;
  }

  .hs-pd-inq-head p {
    margin: 8px 0 22px;
    font-size: 14.5px;
    line-height: 1.7;
    color: #64748b;
  }

  .hs-pd-inq-head strong {
    color: #0f172a;
  }

  .hs-pd-form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .hs-pd-field {
    margin-bottom: 16px;
  }

  .hs-pd-field label {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 6px;
  }

  .hs-pd-field input,
  .hs-pd-field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-pd-field input:focus,
  .hs-pd-field textarea:focus {
    background: #ffffff;
    border-color: #2596d1;
    box-shadow: 0 0 0 3px rgba(37, 150, 209, 0.14);
  }

  .hs-pd-related-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .hs-pd-related-head a {
    font-size: 14px;
    font-weight: 600;
    color: #2596d1;
  }

  .hs-pd-related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 1120px) {
    .hs-pd-hero {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hs-pd-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hs-pd-form-row {
      grid-template-columns: 1fr;
    }
    .hs-pd-title {
      font-size: 21px;
    }
  }
</style>