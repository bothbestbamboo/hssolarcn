---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import ProductSidebar from '../components/ProductSidebar.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.id - b.data.id);
---

<BaseLayout
  title="全部商品 - 宏晟光伏: 太阳能板与光伏板的生产厂家"
  description="浏览宏晟光伏全系列太阳能组件、逆变器、电池存储、太阳能解决方案、安装系统及配件产品。"
>
  <InnerBanner
    title="全部产品"
    subtitle="厂家直供高效光伏组件、智能逆变器、锂电池储能系统及成套光伏系统配件。"
    bannerImg="/Public/theme/default/picture/product.jpg"
    bannerAlt="全部产品"
    breadcrumbs={[{ label: '产品中心' }]}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container hs-two-col">
      <!-- 左侧产品分类与新品 -->
      <ProductSidebar />

      <!-- 右侧产品网格 -->
      <div class="hs-main-col">
        <div id="search-notice" class="hs-search-banner" hidden>
          <div>
            搜索结果：<strong id="search-keyword"></strong>
            <span id="search-count" class="hs-search-count"></span>
          </div>
          <a href="/category.html" class="hs-search-clear">清除筛选</a>
        </div>

        <div class="hs-pro-grid" id="product-grid">
          {products.map((item) => (
            <article
              class="hs-pro-card product-card"
              data-title={item.data.title.toLowerCase()}
              data-tags={(item.data.tags || []).join(' ').toLowerCase()}
            >
              <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-media">
                {item.data.tags && item.data.tags.length > 0 && (
                  <span class="hs-pro-badge">{item.data.tags[0]}</span>
                )}
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="hs-pro-body">
                <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-title">
                  {item.data.title}
                </a>
                <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-cta">
                  查看参数与报价 <span>→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="no-result" class="hs-empty-box" hidden>
          未找到匹配的产品。您可以更换关键词重试，或直接{' '}
          <a href="/contact-us.html" style="color: #2596d1; font-weight: 600;">联系我们</a>{' '}
          获取定制型号资料。
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const raw = (params.get('labels') || '').trim();
      const q = raw.toLowerCase();
      if (!q) return;

      const notice = document.getElementById('search-notice');
      const kwEl = document.getElementById('search-keyword');
      const countEl = document.getElementById('search-count');
      const noRes = document.getElementById('no-result');

      const cards = document.querySelectorAll('.product-card');
      let visibleCount = 0;
      cards.forEach((card) => {
        const text = (card.dataset.title || '') + ' ' + (card.dataset.tags || '');
        if (text.includes(q)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (notice && kwEl) {
        kwEl.textContent = raw;
        if (countEl) countEl.textContent = `（共找到 ${visibleCount} 款）`;
        notice.hidden = false;
      }
      if (noRes && visibleCount === 0) {
        noRes.hidden = false;
      }
    })();
  </script>
</BaseLayout>

<style>
  .hs-search-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    margin-bottom: 22px;
    border-radius: 12px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e3a8a;
    font-size: 14px;
  }
  .hs-search-banner[hidden] {
    display: none;
  }
  .hs-search-count {
    margin-left: 4px;
    color: #475569;
    font-size: 13px;
  }
  .hs-search-clear {
    padding: 5px 14px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #93c5fd;
    color: #1a7bb9;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .hs-search-clear:hover {
    background: #2596d1;
    border-color: #2596d1;
    color: #ffffff;
  }
</style>